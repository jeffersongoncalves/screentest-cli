<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\URL;

class ScreentestResolveUrls extends Command
{
    protected $signature = 'screentest:resolve-urls';

    protected $description = 'Resolve named-route/signed-route screenshot URLs for the screentest capture step';

    public function handle(): int
    {
        $entries = json_decode(base64_decode('{{ENTRIES_B64}}'), true) ?? [];

        $results = [];

        foreach ($entries as $entry) {
            try {
                if ($entry['signed']) {
                    // ValidateSignature middleware calls hasValidSignature() with no
                    // arguments, which validates against the ABSOLUTE URL — sign
                    // relative here and the HMAC can never match. Sign absolute (the
                    // default), then strip the scheme+host back off: APP_URL is forced
                    // to match the capture baseUrl exactly, so re-prefixing this
                    // stripped string with baseUrl reassembles the exact absolute
                    // string that was signed.
                    $url = URL::signedRoute($entry['route'], $entry['params']);
                    $appUrl = rtrim(config('app.url'), '/');

                    if (str_starts_with($url, $appUrl)) {
                        $url = substr($url, strlen($appUrl));
                    }
                } else {
                    $url = route($entry['route'], $entry['params'], false);
                }

                $results[$entry['name']] = ['url' => $url];
            } catch (\Throwable $e) {
                $results[$entry['name']] = ['error' => $e->getMessage()];
            }
        }

        $this->line(json_encode($results));

        return self::SUCCESS;
    }
}
